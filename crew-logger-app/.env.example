# Copy to .env. Expo exposes ONLY vars prefixed EXPO_PUBLIC_ to client code
# (app.json `extra` via expo-constants does not populate on web here). Restart
# the dev server after changing these — they are read at bundle time.

# Backend base URL.
#   - browser on this machine: http://localhost:8000
#   - physical phone:          http://<this-machine's-LAN-IP>:8000
#   - behind a reverse proxy:  /api  (same origin, no CORS)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Whose entries these are. Temporary until Phase 2 auth replaces it with the
# identity from the JWT. Must match an existing user's employee_number.
EXPO_PUBLIC_EMPLOYEE_NUMBER=196035
