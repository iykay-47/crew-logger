# Copy to .env and fill in. Both docker-compose and the app read this file,
# so the database credentials are declared once, here, and nowhere else.
# Keep POSTGRES_* and DATABASE_URL in sync manually — DATABASE_URL is spelled
# out literally rather than interpolated, since that's not guaranteed to work
# across every python-dotenv version.

POSTGRES_DB=crew_logger
POSTGRES_USER=crew_logger
POSTGRES_PASSWORD=changeme

# Must match the three values above. Host is `localhost` because the api
# service in docker-compose.yml is commented out — uvicorn runs on the host,
# Postgres in Docker. If you re-enable the containerized api, change this to
# `db`.
DATABASE_URL=postgresql://crew_logger:changeme@localhost:5432/crew_logger

JWT_SECRET=your-secret-key-here
JWT_EXPIRY_DAYS=7

# Browser origins allowed to call the API, comma-separated. Defaults to
# Expo's web dev server if unset. Never use "*" on a reachable network.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
